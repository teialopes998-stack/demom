local function fit()
  local view=gui.AbsoluteSize
  if view.X<=0 or view.Y<=0 then return end
  scale.Scale=math.max(0.1,math.min(1,(view.X-52)/340,(view.Y-52)/(minimized and 70 or 502)))
  local half=Vector2.new(340,minimized and 70 or 502)*scale.Scale/2
  local x=panel.Position.X.Scale*view.X+panel.Position.X.Offset
  local y=panel.Position.Y.Scale*view.Y+panel.Position.Y.Offset
  panel.Position=UDim2.fromOffset(math.clamp(x,half.X+22,math.max(half.X+22,view.X-half.X-22)),math.clamp(y,half.Y+22,math.max(half.Y+22,view.Y-half.Y-22)))
end
