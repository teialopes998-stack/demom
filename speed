local function start(power)
  stop()
  power = math.clamp(math.floor(power + 0.5), 10000, 300000)
  -- Stronger bypass without a frozen/delayed look:
  -- 1) Network pressure (blocklist remote + open KBPS) does the real work
  -- 2) Tiny Heartbeat micro-stalls only when FPS is healthy
  -- 3) Hard cap + adaptive skip so RenderStepped/FPS stay clean
  local intensity = (power - 10000) / 290000 -- 0..1
  -- Soft client stall only (max ~12ms, never on the render step)
  local baseBudget = intensity * 0.012
  local slice = 0.001 -- 1ms slices — barely perceptible
  local frameCounter = 0
  local frameSkip = intensity < 0.35 and 2 or 1
  local lastDt = 0
  active = true

  -- Prefer network desync over frame murder
  pcall(function()
    game:GetService("NetworkClient"):SetOutgoingKBPSLimit(math.huge)
  end)

  local remote = nil
  pcall(function()
    local rrs = game:FindFirstChild("RobloxReplicatedStorage")
    if not rrs then return end
    remote = rrs:FindFirstChild("SetPlayerBlockList")
      or rrs:FindFirstChild("UpdatePlayerBlockList")
      or rrs:FindFirstChild("SetBlockList")
      or rrs:FindFirstChild("UpdateBlockList")
    if not remote then
      for _, c in ipairs(rrs:GetChildren()) do
        if c:IsA("RemoteEvent") and tostring(c.Name):find("Block") then
          remote = c
          break
        end
      end
    end
  end)

  local bomb = table.create(math.clamp(math.floor(20 + intensity * 80), 20, 100))
  for i = 1, #bomb do bomb[i] = i end

  local fireEvery = intensity > 0.7 and 2 or (intensity > 0.4 and 3 or 4)
  local fireAcc = 0

  lagConn = RS.Heartbeat:Connect(function(dt)
    if not active or not alive then return end
    lastDt = dt or lastDt
    frameCounter = frameCounter + 1

    -- Network fire on a light cadence (strength without client freeze)
    fireAcc = fireAcc + 1
    if remote and fireAcc >= fireEvery then
      fireAcc = 0
      pcall(function() remote:FireServer(bomb) end)
    end

    -- Skip stall entirely if the frame is already heavy (protect FPS / feel)
    if lastDt and lastDt > 1 / 45 then
      return
    end
    if frameCounter % frameSkip ~= 0 then
      return
    end

    local budget = baseBudget
    -- Ease off further if recent frames are soft-stuttering
    if lastDt and lastDt > 1 / 55 then
      budget = budget * 0.35
    end
    if budget <= 0.0005 then
      return
    end

    local remaining = budget
    local wall0 = os.clock()
    while active and remaining > 0 do
      local piece = remaining < slice and remaining or slice
      local began = os.clock()
      while active and os.clock() - began < piece do end
      remaining = remaining - piece
      -- Hard wall: never burn more than 12ms even if budget says more
      if os.clock() - wall0 >= 0.012 then
        break
      end
    end
  end)
end
